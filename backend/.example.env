APP_DEBUG = false

[APP]
DEFAULT_APP = admin

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = sdccc_admin
USERNAME = sdccc_admin
PASSWORD = 生产库强密码
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = sdccc_

[JWT]
KEY = 生产环境必须换成32位以上随机串（openssl rand -hex 32 生成）
EXPIRE = 604800

[UPLOAD]
; 上传大小限制（MB）
MAX_SIZE = 20
; 允许的扩展名
ALLOW_EXT = jpg,jpeg,png,gif,webp,xlsx,xls,doc,docx,pdf,zip,txt

[BACKUP]
; 备份目录（留空则用 backend/runtime/backup）
DIR =
; 保留份数
KEEP = 20
; mysqldump 路径（留空则自动探测）
MYSQLDUMP =

[UPGRADE]
; 是否开放远程升级
ENABLED = true
; 升级源根地址（放 manifest.json 与升级 zip 的目录）末尾不要带 /
REMOTE = https://upgrade.example.com/jianzhanla
; 应用标识，需与远端 manifest.json 的 appid 一致
APPID = jianzhanla-admin
; 验签密钥，留空则只校验 sha256（生产必须配置，并与发版侧一致）
SECRET =
; 通道：stable | beta | dev，留空跟随 config/version.php
CHANNEL = stable
; 升级前自动做整库 SQL 备份
BACKUP_DB = true
