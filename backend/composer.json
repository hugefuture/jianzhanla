{
    "name": "hanzhi/jianzhanla-admin",
    "description": "ThinkPHP8 多应用后台管理框架（controller/service/dao/model 四层）",
    "type": "project",
    "keywords": ["thinkphp", "admin", "rbac"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0",
        "topthink/think-multi-app": "^1.0",
        "topthink/think-filesystem": "^2.0",
        "firebase/php-jwt": "^7.2",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "require-dev": {
        "topthink/think-trace": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app",
            "plugin\\": "plugin"
        },
        "psr-0": {
            "": "extend/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "secure-http": false
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover"
        ]
    }
}
